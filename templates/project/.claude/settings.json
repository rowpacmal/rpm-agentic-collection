{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "rpm": {
      "source": {
        "source": "github",
        "repo": "rowpacmal/rpm-agentic-collection"
      }
    }
  },
  "enabledPlugins": {
    "rpm-core@rpm": true,
    "rpm-security@rpm": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)"
    ]
  }
}
